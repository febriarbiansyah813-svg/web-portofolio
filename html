<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profil & Kuesioner Evaluasi - Mohamad Febri Arbiansyah</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #0f172a, #1e1b4b, #312e81, #4c1d95);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
            padding: 20px 15px;
            color: #f8fafc;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .container {
            width: 100%;
            max-width: 850px;
            margin: 0 auto;
        }

        .page-section {
            display: none;
            opacity: 0;
            transform: translateY(15px);
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        .page-section.active {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }

        h1.main-title {
            color: #ffffff;
            font-size: 2rem;
            margin-bottom: 25px;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            text-align: center;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 20px;
            padding: 35px;
            color: #f8fafc;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            margin-bottom: 25px;
        }

        .glass-card h2 {
            font-size: 1.8rem;
            font-weight: 700;
            background: linear-gradient(90deg, #38bdf8, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 4px;
        }

        .subtitle {
            font-size: 1rem;
            color: #38bdf8;
            margin-bottom: 25px;
            font-weight: 600;
        }

        .profil-table {
            width: 100%;
            border-collapse: collapse;
        }

        .profil-table th, 
        .profil-table td {
            padding: 14px 10px;
            vertical-align: top;
            font-size: 0.95rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .profil-table tr:last-child th,
        .profil-table tr:last-child td {
            border-bottom: none;
        }

        .profil-table th {
            width: 25%;
            color: #38bdf8;
            font-weight: 600;
            text-align: left;
            white-space: nowrap;
        }

        .profil-table td {
            color: #cbd5e1;
            line-height: 1.6;
            text-align: justify;
        }

        .profil-table ul {
            list-style-type: none;
            padding-left: 0;
            margin: 0;
        }

        .profil-table ul li {
            position: relative;
            padding-left: 20px;
            margin-bottom: 6px;
            color: #cbd5e1;
        }

        .profil-table ul li::before {
            content: "▹";
            position: absolute;
            left: 0;
            color: #38bdf8;
            font-size: 1.1rem;
            line-height: 1;
        }

        .btn-navigation-container {
            display: flex;
            justify-content: center;
            margin-top: 15px;
        }

        .btn-action {
            background: linear-gradient(135deg, #0284c7, #7c3aed);
            color: white;
            border: none;
            padding: 12px 30px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-action:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(56, 189, 248, 0.4);
            background: linear-gradient(135deg, #0369a1, #6d28d9);
        }

        .btn-action.btn-secondary {
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .btn-action.btn-secondary:hover {
            background: rgba(255, 255, 255, 0.25);
        }

        .instruction-box {
            background: rgba(56, 189, 248, 0.1);
            border-left: 4px solid #38bdf8;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 25px;
            font-size: 0.9rem;
            line-height: 1.5;
            color: #e2e8f0;
        }

        .likert-scale-guide {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
            font-size: 0.85rem;
            color: #38bdf8;
        }

        .likert-scale-guide span {
            background: rgba(255, 255, 255, 0.08);
            padding: 3px 8px;
            border-radius: 4px;
        }

        .question-item {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 18px;
            margin-bottom: 20px;
            transition: border-color 0.3s ease;
        }

        .question-item.has-error {
            border-color: #f43f5e;
        }

        .question-title {
            font-size: 0.98rem;
            font-weight: 500;
            color: #f1f5f9;
            margin-bottom: 12px;
            line-height: 1.5;
        }

        .rating-options {
            display: flex;
            gap: 10px;
            justify-content: space-between;
            max-width: 450px;
        }

        .rating-btn {
            flex: 1;
            position: relative;
        }

        .rating-btn input[type="radio"] {
            position: absolute;
            opacity: 0;
            cursor: pointer;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            margin: 0;
            z-index: 2;
        }

        .rating-btn label {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 42px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 10px;
            color: #f8fafc;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .rating-btn input[type="radio"]:checked + label {
            background: linear-gradient(135deg, #38bdf8, #818cf8);
            color: #0f172a;
            border-color: #38bdf8;
            box-shadow: 0 0 12px rgba(56, 189, 248, 0.5);
            font-weight: 700;
        }

        .rating-btn:hover label {
            background: rgba(255, 255, 255, 0.2);
        }

        .checkbox-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 12px;
        }

        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.93rem;
            color: #cbd5e1;
            cursor: pointer;
        }

        .checkbox-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #38bdf8;
            cursor: pointer;
        }

        .text-input-field {
            width: 100%;
            padding: 10px 14px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            color: white;
            font-size: 0.9rem;
            outline: none;
            margin-top: 8px;
        }

        .text-input-field:focus {
            border-color: #38bdf8;
            background: rgba(255, 255, 255, 0.12);
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(8px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 999;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
            padding: 20px;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-content {
            background: rgba(30, 27, 75, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 30px;
            max-width: 500px;
            width: 100%;
            text-align: center;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
            transform: scale(0.9);
            transition: transform 0.3s ease;
        }

        .modal-overlay.active .modal-content {
            transform: scale(1);
        }

        .modal-icon {
            font-size: 3rem;
            margin-bottom: 10px;
        }

        .score-box {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 15px;
            margin: 15px 0;
        }

        .score-badge {
            display: inline-block;
            background: linear-gradient(135deg, #38bdf8, #a855f7);
            color: #0f172a;
            font-size: 1.8rem;
            font-weight: 700;
            padding: 6px 20px;
            border-radius: 50px;
            margin-top: 5px;
        }

        .completed-banner {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.4);
            color: #fca5a5;
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 0.9rem;
            text-align: center;
        }

        @media (max-width: 600px) {
            .profil-table th, 
            .profil-table td {
                display: block;
                width: 100%;
                padding: 6px 0;
            }
            .profil-table th {
                margin-top: 10px;
                border-bottom: none;
            }
            .profil-table td {
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                padding-bottom: 12px;
            }
            .glass-card {
                padding: 22px;
            }
            .rating-options {
                gap: 5px;
            }
            .rating-btn label {
                height: 38px;
                font-size: 0.88rem;
            }
        }
    </style>
</head>
<body>

<div class="container">

    <div class="page-section active" id="halaman-profil">
        <h1 class="main-title">Profil Saya</h1>
        
        <div class="glass-card" id="profil-card">
            <h2>NAMA   : MOHAMAD FEBRI ARBIANSYAH</h2>
            <h2>KELAS  : 01TPLK005</h2>
